# URL de l'instance Supabase (self-hosted : https://supabase.evoranq.com).
VITE_SUPABASE_URL=https://supabase.example.com
# Cle « anon » uniquement. Elle est publique et embarquee dans le bundle.
# N'utilisez JAMAIS la cle service_role ici : elle contourne les RLS.
VITE_SUPABASE_PUBLISHABLE_KEY=your-supabase-anon-key
# FastAPI backend used for AI generation and business calculations.
VITE_API_URL=http://127.0.0.1:8000
# Resultats d'analyse fictifs (couches A, B, C) tant qu'aucun run reel n'existe.
VITE_EVALUATION_DEMO=false
